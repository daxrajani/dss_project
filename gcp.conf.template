# DSS Project — GCP configuration
# ─────────────────────────────────────────────────────────────────────
# Copy this file to gcp.conf and fill in your values:
#
#   cp gcp.conf.template gcp.conf
#
# gcp.conf is .gitignored — it stays on your machine only.
# ─────────────────────────────────────────────────────────────────────

# Your GCP project ID  (find it at console.cloud.google.com)
GCP_PROJECT = your-project-id

# Your GCS bucket  (include the gs:// prefix)
GCS_BUCKET = gs://your-bucket-name

# Region where your Dataproc cluster runs  (default: us-central1)
GCP_REGION = us-central1
